{
  "name": "agentos",
  "version": "0.2.0-phase-a",
  "description": "Reusable agent orchestration, lifecycle, coordination, supervision and execution-control platform.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:recovery": "node tests/resumability.node.js",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run test:recovery",
    "start": "node dist/api/server.js",
    "worker": "node dist/worker/index.js",
    "demo": "npm run build && tsc -p tsconfig.demo.json && mkdir -p dist-demo/src/db/migrations && cp -r src/db/migrations/. dist-demo/src/db/migrations/ && node dist-demo/examples/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "require": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
