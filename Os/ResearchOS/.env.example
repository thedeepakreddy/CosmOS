# ResearchOS environment.
#
# Copy to `.env` (or `.env.local`, which is loaded second and overrides it).
# Real environment variables always win over both — a value exported in a shell,
# set by a container or injected by a secret manager is never overridden by a
# stale dotfile. Loaded by scripts/register.mjs.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The driver is inferred from the scheme, so a postgres:// URL cannot be pointed
# at the SQLite adapter by mistake. The default needs no infrastructure at all.
#
#   sqlite::memory:                   ephemeral
#   sqlite:.data/research-os.db       a file (default)
#   postgres://user:pw@host:5432/db   production
RESEARCH_OS_DATABASE_URL=sqlite:.data/research-os.db

# Postgres only.
# RESEARCH_OS_DATABASE_POOL_SIZE=10
# RESEARCH_OS_DATABASE_CONNECT_TIMEOUT_MS=10000
# RESEARCH_OS_DATABASE_STATEMENT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Absent a key, the Anthropic provider is simply not registered. That is a valid
# setup — the test suite runs entirely on the scripted provider.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini. Either variable works; GEMINI_API_KEY is checked first because
# GOOGLE_API_KEY is shared with other Google services and may be set for an
# unrelated reason. Gemini is the only catalog with an embedding model, so a
# Gemini deployment has hybrid retrieval where an Anthropic-only one is lexical.
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Configuring BOTH vendors is what enables independent verification: a review by
# the same provider that produced the artifact is a self-review, and the router
# reports it as one rather than pretending otherwise.

# Per-model pricing, in USD per million tokens. REQUIRED for every model you
# intend to route to.
#
# Prices are configuration rather than a compiled-in constant because published
# rates change, and a stale rate does not fail — it silently mis-bills every
# research run, and budget enforcement reads those numbers to decide when to
# stop. A model with no configured price is refused at start-up instead of being
# billed at zero. Fill these in from the provider's current published rates.
#
# RESEARCH_OS_MODEL_PRICING={"claude-opus-5":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0},"claude-sonnet-5":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0},"claude-haiku-4-5-20251001":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0}}
#
# The same variable prices Gemini models:
# RESEARCH_OS_MODEL_PRICING={"gemini-3.8-flash":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0},"gemini-flash-latest":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0},"gemini-flash-lite-latest":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0},"gemini-embedding-001":{"inputCostPerMTokUsd":0,"outputCostPerMTokUsd":0}}
